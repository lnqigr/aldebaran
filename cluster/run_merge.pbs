#!/bin/bash
# ==============================================================================
# ALDEBARAN v9.0 - TIER-2 MERGE, DEEP VETTING & TIER-4 TRICERATOPS REDUCER
# ==============================================================================
#PBS -N merge_shards
#PBS -l select=1:ncpus=8:mem=24gb:scratch_local=25gb
#PBS -l walltime=04:00:00
#PBS -m ae
#PBS -j oe

echo "======================================================================"
echo "Starting Aldebaran Shard Merge & Pleiades Vetting on $(hostname)"
echo "Job ID: $PBS_JOBID"
echo "Start time: $(date)"
echo "======================================================================"

REPO_DIR="$PBS_O_WORKDIR"
if [ ! -f "$REPO_DIR/merge_shards.py" ] && [ -f "$REPO_DIR/../merge_shards.py" ]; then
    REPO_DIR="$(cd "$REPO_DIR/.." && pwd)"
fi
cd "$REPO_DIR" || exit 1

module add python/3.11 2>/dev/null || module add python 2>/dev/null || true

export XDG_CACHE_HOME="$SCRATCHDIR/.cache"
export PIP_CACHE_DIR="$SCRATCHDIR/.cache/pip"
export LIGHTKURVE_CACHE_DIR="$SCRATCHDIR/.cache/lightkurve"
export ASTROPY_CACHE_DIR="$SCRATCHDIR/.cache/astropy"
export MPLCONFIGDIR="$SCRATCHDIR/.cache/matplotlib"
mkdir -p "$XDG_CACHE_HOME" "$PIP_CACHE_DIR" "$LIGHTKURVE_CACHE_DIR" "$ASTROPY_CACHE_DIR" "$MPLCONFIGDIR"

python3 -m venv "$SCRATCHDIR/venv"
source "$SCRATCHDIR/venv/bin/activate"
pip install --upgrade pip --no-cache-dir --quiet
if [ -f requirements.txt ]; then
    pip install --no-cache-dir --quiet -r requirements.txt certifi triceratops
else
    pip install --no-cache-dir --quiet numpy scipy astropy pandas lightkurve astroquery matplotlib requests urllib3 certifi triceratops
fi

python merge_shards.py

# Priority P5: Tier-4 TRICERATOPS Bayesian Statistical Validation on Golden Candidates
if [ -f validate_triceratops.py ]; then
    echo "======================================================================"
    echo "Launching Tier-4 TRICERATOPS Bayesian Validation on $(hostname)"
    echo "Start time: $(date)"
    echo "======================================================================"
    python validate_triceratops.py --auto
fi

clean_scratch
echo "======================================================================"
echo "Merge and Pleiades vetting completed at: $(date)"
echo "======================================================================"
