#!/bin/bash
# ==============================================================================
# ALDEBARAN TESS PIPELINE v8.5 - METACENTRUM PBS PRO BATCH SCRIPT
# ==============================================================================
# Supports both Single-Node runs and Multi-Node Job Arrays (qsub -J 1-8).
# In array mode (qsub -J 1-8), each worker index automatically maps to an independent
# fresh TESS sector (106, 105, 104, 103, 102, 101, 100, 99) in isolated subdirectories,
# preventing file collisions or network congestion on NASA MAST.
#
# Resources per node: 8 CPUs, 24 GB RAM, 35 GB local NVMe scratch, 8h walltime.
# (8 cores per node matches NASA MAST download throughput without wasting fairshare).
#PBS -N aldebaran_tess
#PBS -l select=1:ncpus=8:mem=24gb:scratch_local=35gb
#PBS -l walltime=08:00:00
#PBS -m ae
#PBS -j oe

export ALDEBARAN_MAX_TARGETS="${ALDEBARAN_MAX_TARGETS:-15000}"
export ALDEBARAN_WORKERS="${PBS_NCPUS:-8}"

# Locate project root directory regardless of whether qsub was called from root or cluster/
REPO_DIR="$PBS_O_WORKDIR"
if [ ! -f "$REPO_DIR/aldebaran.py" ] && [ -f "$REPO_DIR/../aldebaran.py" ]; then
    REPO_DIR="$(cd "$REPO_DIR/.." && pwd)"
fi

# ------------------------------------------------------------------------------
# 1. Safe sync & cleanup. Runs exactly once on normal exit, crash, walltime SIGTERM or qdel.
# ------------------------------------------------------------------------------
SYNCED=0
PY_PID=""
SYNC_LOOP_PID=""

sync_results() {
    if [ -d "$SCRATCHDIR/tess_results" ]; then
        mkdir -p "$REPO_DIR/tess_results"
        cp -rf "$SCRATCHDIR/tess_results"/. "$REPO_DIR/tess_results/" 2>/dev/null || true
    fi
}

sync_and_clean() {
    [ "$SYNCED" -eq 1 ] && return
    SYNCED=1
    echo "======================================================================"
    echo "[TRAP] Final result synchronization at: $(date)"
    [ -n "$SYNC_LOOP_PID" ] && kill "$SYNC_LOOP_PID" 2>/dev/null
    sync_results
    echo "[TRAP] Reports, logs and dossiers synced to: $REPO_DIR/tess_results"
    clean_scratch
    echo "[TRAP] Local scratch cleaned."
    echo "======================================================================"
}

on_signal() {
    echo "[TRAP] Termination signal received (walltime / qdel). Stopping pipeline..."
    # Forward SIGTERM so aldebaran.py writes its Run Summary, give it a few seconds.
    [ -n "$PY_PID" ] && kill -TERM "$PY_PID" 2>/dev/null && sleep 5
    sync_and_clean
    exit 143   # IMPORTANT: without exit, bash would resume the next step on a wiped scratch
}

trap sync_and_clean EXIT
trap on_signal TERM INT

# Runs a Python step in the background and waits on it, so bash can react to SIGTERM
# immediately (bash defers traps while a FOREGROUND child is running).
run_py() {
    python "$@" &
    PY_PID=$!
    wait "$PY_PID"
    local rc=$?
    PY_PID=""
    return $rc
}

echo "======================================================================"
echo "Starting Aldebaran TESS Job on MetaCentrum node: $(hostname)"
echo "Job ID: $PBS_JOBID | Array Index: ${PBS_ARRAY_INDEX:-Single-Job}"
echo "Workers: $ALDEBARAN_WORKERS | Batch Limit: $ALDEBARAN_MAX_TARGETS"
echo "PBS Working Directory: $PBS_O_WORKDIR"
echo "Local Scratch Directory: $SCRATCHDIR"
echo "Start time: $(date)"
echo "======================================================================"

# ------------------------------------------------------------------------------
# 2. Python >= 3.10 is required
# ------------------------------------------------------------------------------
module add python/3.11 2>/dev/null || module add python 2>/dev/null || true
if ! python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)'; then
    echo "[!] python3 >= 3.10 required, found: $(python3 --version 2>&1). Fix the 'module add' line."
    exit 3
fi
echo "Python: $(python3 --version)"

# ------------------------------------------------------------------------------
# 3. All caches on node-local NVMe scratch (nothing is written to the shared $HOME quota).
# ------------------------------------------------------------------------------
export XDG_CACHE_HOME="$SCRATCHDIR/.cache"
export PIP_CACHE_DIR="$SCRATCHDIR/.cache/pip"
export LIGHTKURVE_CACHE_DIR="$SCRATCHDIR/.cache/lightkurve"
export ASTROPY_CACHE_DIR="$SCRATCHDIR/.cache/astropy"
export MPLCONFIGDIR="$SCRATCHDIR/.cache/matplotlib"
mkdir -p "$XDG_CACHE_HOME" "$PIP_CACHE_DIR" "$LIGHTKURVE_CACHE_DIR" "$ASTROPY_CACHE_DIR" "$MPLCONFIGDIR"

# ------------------------------------------------------------------------------
# 4. Copy code AND existing tess_results to local scratch
# ------------------------------------------------------------------------------
cp "$REPO_DIR"/*.py "$SCRATCHDIR/"
cp "$REPO_DIR"/requirements.txt "$SCRATCHDIR/" 2>/dev/null || true
mkdir -p "$SCRATCHDIR/tess_results"
if [ -d "$REPO_DIR/tess_results" ]; then
    cp -rf "$REPO_DIR/tess_results"/. "$SCRATCHDIR/tess_results/" 2>/dev/null || true
fi
cd "$SCRATCHDIR" || exit 1

# ------------------------------------------------------------------------------
# 5. Virtual environment on scratch (node-local build avoids glibc mismatches)
# ------------------------------------------------------------------------------
echo "[1/4] Setting up Python virtual environment in scratch..."
python3 -m venv "$SCRATCHDIR/venv"
source "$SCRATCHDIR/venv/bin/activate"
pip install --upgrade pip --no-cache-dir --quiet
if [ -f requirements.txt ]; then
    pip install --no-cache-dir --quiet -r requirements.txt certifi
else
    pip install --no-cache-dir --quiet numpy scipy astropy pandas lightkurve astroquery matplotlib requests urllib3 certifi
fi

# Periodic sync every 20 min in case the node dies hard
( while true; do sleep 1200; sync_results; done ) &
SYNC_LOOP_PID=$!

# Initial jitter (0-20s) if running as array to desynchronize batch downloads
if [ -n "${PBS_ARRAY_INDEX:-}" ]; then
    SLEEP_SEC=$(( (PBS_ARRAY_INDEX * 3) % 20 ))
    echo "[*] Array worker ${PBS_ARRAY_INDEX}: pacing start by ${SLEEP_SEC}s..."
    sleep $SLEEP_SEC
fi

# ------------------------------------------------------------------------------
# 6. Tier-1 screening
# ------------------------------------------------------------------------------
echo "[2/4] Launching Aldebaran Tier-1 Pipeline..."
run_py aldebaran.py

# ------------------------------------------------------------------------------
# 7. Tier-2 deep vetting (if single job) or shard registration (if array)
# ------------------------------------------------------------------------------
if [ -z "${PBS_ARRAY_INDEX:-}" ]; then
    if [ -s "tess_results/candidates_report.csv" ]; then
        echo "[3/4] Candidates found! Launching Pleiades Tier-2 Deep Vetting..."
        run_py pleiades.py
    else
        echo "[3/4] No candidates found in this batch. Tier-2 vetting skipped."
    fi
else
    echo "[3/4] Array shard complete. Output staged in tess_results/sector_*. Run merge_shards.py after array completes."
fi

# Final sync + scratch cleanup are performed by the EXIT trap.
echo "[4/4] Pipeline execution finished at: $(date)"
